# Pulse credentials. Copy to .env and fill in. NEVER commit .env.
# Nothing in config/ holds a secret - those files only name which sheet or
# database to open. Every actual key lives here.

# ---------------------------------------------------------------------------
# Google Sheets
# ---------------------------------------------------------------------------
# Create a service account in Google Cloud Console (IAM -> Service Accounts),
# add a JSON key, then paste two values from that file below.
# The service account has its own email address. Share each tracker sheet with
# that address as a Viewer, exactly like sharing with a colleague.
GOOGLE_SA_EMAIL=pulse@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Notion
# ---------------------------------------------------------------------------
# notion.so/my-integrations -> New integration -> copy the Internal Integration
# Secret. Then open each database, ... menu -> Connections -> add the integration.
NOTION_API_KEY=ntn_...

# ---------------------------------------------------------------------------
# Product database (sources.json id: product_db, ref: PRODUCT_DB_URL)
# ---------------------------------------------------------------------------
# Preferred: through Supabase/PostgREST, no driver needed.
PRODUCT_DB_URL_REST_URL=https://xxxx.supabase.co/rest/v1
PRODUCT_DB_URL_REST_KEY=
# Local-laptop alternative, uses the psql binary:
# PULSE_ALLOW_PSQL=1
# PRODUCT_DB_URL=postgres://readonly:pass@host:5432/db

# ---------------------------------------------------------------------------
# Pulse's own storage
# ---------------------------------------------------------------------------
# Reuses the Supabase project that already backs shopos-org-KPIs.
PULSE_SUPABASE_URL=https://ypuinaryddkudzrkfusm.supabase.co
PULSE_SUPABASE_SERVICE_KEY=

# Where snapshots and decisions are written when running file-backed (no Supabase).
PULSE_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Transcript extraction
# ---------------------------------------------------------------------------
# The model that turns a transcript into structured decisions.
ANTHROPIC_API_KEY=
PULSE_EXTRACTION_MODEL=claude-opus-4-8
