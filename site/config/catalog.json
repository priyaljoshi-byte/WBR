      "denominator": { "kind": "metric", "metric": "sloosh_signups" }, "direction": "up", "target": null, "warn_at": 0.5, "crit_at": 0.25,
      "caption": "{{raw}} of {{denominator}}" },

    { "id": "sloosh_paid", "label": "Converted to paid", "dept": "sloosh", "unit": "count",
      "source": { "ref": "sloosh_db", "tab": "signups", "agg": "count", "where": { "column": "paid", "equals": true } },
      "denominator": { "kind": "metric", "metric": "sloosh_signups" }, "direction": "up", "target": null, "warn_at": 0.4, "crit_at": 0.2,
      "caption": "{{raw}} of {{denominator}}" },

    { "id": "sloosh_wau", "label": "Weekly active", "dept": "sloosh", "unit": "count",
      "source": { "ref": "sloosh_db", "tab": "active", "agg": "count_distinct", "column": "user_id" },
      "denominator": { "kind": "self" }, "direction": "up", "target": null, "warn_at": 0.7, "crit_at": 0.4,
      "caption": "{{raw}} active" },

    { "id": "sloosh_revenue", "label": "Revenue", "dept": "sloosh", "unit": "currency_inr",
      "source": { "ref": "sloosh_db", "tab": "revenue", "agg": "sum", "column": "amount" },
      "denominator": { "kind": "static", "value": null, "label": "target" }, "direction": "up", "target": null, "warn_at": 0.7, "crit_at": 0.4,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_shipped", "label": "Shipped", "dept": "sloosh", "unit": "count",
      "source": { "ref": "sloosh_board", "agg": "count", "where": { "column": "status", "equals": "Done" } },
      "denominator": { "kind": "static", "value": null, "label": "committed" }, "direction": "up", "target": null, "warn_at": 0.7, "crit_at": 0.4,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_in_progress", "label": "In progress", "dept": "sloosh", "unit": "count",
      "source": { "ref": "sloosh_board", "agg": "count", "where": { "column": "status", "equals": "In Progress" } },
      "denominator": { "kind": "static", "value": null, "label": "wip limit" }, "direction": "down", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_releases", "label": "Releases", "dept": "sloosh", "unit": "count",
      "source": { "ref": "sloosh_board", "agg": "count", "where": { "column": "type", "equals": "release" } },
