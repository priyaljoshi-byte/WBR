      "id": "sloosh-funnel-web",
      "title": "Sloosh marketing funnel",
      "dept": "sloosh",
      "section": "lines",
      "order": 9,
      "subtitle": "{{period.range}} · landed to paid",
      "_note": "Read outside-in. The outer ring is everyone who landed and is always full - it is the mouth of the funnel. The two inner rings are each a fraction of the step ABOVE them, not of the total, so the gap between the arcs IS the drop-off. A funnel drawn against the total instead would make signup-to-paid look fine whenever landed was large.",
      "rings": ["sloosh_web_landed", "sloosh_web_signup", "sloosh_web_paid"],
      "tiles": [
        { "metric": "sloosh_web_landed", "label": "LANDED",  "sublabel": "THIS WEEK", "format": "raw" },
        { "metric": "sloosh_web_signup", "label": "SIGNUPS", "sublabel": "THIS WEEK", "format": "raw" },
        { "metric": "sloosh_web_paid",   "label": "PAID",    "sublabel": "THIS WEEK", "format": "raw" }
      ]
    },
    {
      "id": "sloosh-social",
      "title": "Sloosh social",
      "dept": "sloosh",
      "section": "lines",
      "order": 10,
      "subtitle": "Followers by platform",
      "_note": "Four platforms, three ring slots. Instagram, LinkedIn and X take the rings because they are where Sloosh posts weekly; YouTube reads as a tile. Each ring is that platform's share of the total audience, which is the only honest arc for a follower count with no target - the alternative was a ring against an invented number. The real total is the sloosh_followers family rollup, not any one ring. CONFIRM which three platforms should hold the rings.",
      "rings": ["sloosh_followers_instagram", "sloosh_followers_linkedin", "sloosh_followers_x"],
      "tiles": [
        { "metric": "sloosh_followers_youtube", "label": "YOUTUBE", "sublabel": "SUBSCRIBERS", "format": "raw" }
      ]
    },
