    { "id": "sloosh_cycle_time", "label": "Cycle time", "dept": "sloosh", "unit": "duration_days",
      "source": { "ref": "sloosh_board", "agg": "median", "column": "cycle_days" },
      "denominator": { "kind": "self" }, "direction": "down", "target": null, "warn_at": 0.7, "crit_at": 0.4,
      "caption": "{{raw}}" },

    { "id": "sloosh_web_landed", "label": "Landed", "dept": "sloosh", "unit": "count",
      "_note": "The mouth of the funnel, and the only one of the three denominated by its own column total. That is deliberate: it makes the outer ring read full, so the two inner arcs are visibly a fraction of it rather than three unrelated rings sharing a card. kind=self would have drawn no arc at all and the card would have looked broken.",
      "source": { "ref": "sloosh_web", "agg": "sum", "column": "landed" },
      "denominator": { "kind": "column_total", "column": "landed", "label": "landed" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} landed" },

    { "id": "sloosh_web_signup", "label": "Signed up", "dept": "sloosh", "unit": "count",
      "source": { "ref": "sloosh_web", "agg": "sum", "column": "signups" },
      "denominator": { "kind": "metric", "metric": "sloosh_web_landed", "label": "landed" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_web_paid", "label": "Paid", "dept": "sloosh", "unit": "count",
      "_note": "A fraction of SIGNUPS, not of landed. Chained the same way sloosh_activated chains off sloosh_signups, so the drop between the middle and inner ring is the signup-to-paid conversion and nothing else.",
      "source": { "ref": "sloosh_web", "agg": "sum", "column": "paid" },
      "denominator": { "kind": "metric", "metric": "sloosh_web_signup", "label": "signups" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_followers_instagram", "label": "Instagram", "dept": "sloosh", "family": "sloosh_followers", "unit": "count",
      "_note": "All four platforms share family sloosh_followers, so rollupFamily() gives one audience total and nobody adds four numbers by hand in a slide. The denominator is the week's follower column total, so each ring is that platform's share of the audience.",
      "source": { "ref": "sloosh_social", "agg": "sum", "column": "followers", "where": { "column": "platform", "equals": "instagram" } },
      "denominator": { "kind": "column_total", "column": "followers", "label": "total" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_followers_linkedin", "label": "LinkedIn", "dept": "sloosh", "family": "sloosh_followers", "unit": "count",
      "source": { "ref": "sloosh_social", "agg": "sum", "column": "followers", "where": { "column": "platform", "equals": "linkedin" } },
      "denominator": { "kind": "column_total", "column": "followers", "label": "total" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_followers_x", "label": "X", "dept": "sloosh", "family": "sloosh_followers", "unit": "count",
      "source": { "ref": "sloosh_social", "agg": "sum", "column": "followers", "where": { "column": "platform", "equals": "x" } },
      "denominator": { "kind": "column_total", "column": "followers", "label": "total" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "sloosh_followers_youtube", "label": "YouTube", "dept": "sloosh", "family": "sloosh_followers", "unit": "count",
      "source": { "ref": "sloosh_social", "agg": "sum", "column": "followers", "where": { "column": "platform", "equals": "youtube" } },
      "denominator": { "kind": "column_total", "column": "followers", "label": "total" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "hiring_plan", "label": "Openings in plan", "dept": "hiring", "unit": "count",
      "source": { "ref": "hiring_tracker", "tab": "Roles", "agg": "sum", "column": "headcount", "where": { "column": "status", "in": ["open", "on_hold"] } },
      "denominator": { "kind": "self" }, "direction": "up", "target": null, "warn_at": null, "crit_at": null,
      "caption": "{{raw}} openings",
      "_note": "Headcount summed over every role on the open-roles tab that is not Closed. The 'in plan' every other hiring ring is read against." },

    { "id": "hiring_open_roles", "label": "Open roles", "dept": "hiring", "unit": "count",
      "source": { "ref": "hiring_tracker", "tab": "Roles", "agg": "count", "where": { "column": "status", "equals": "open" } },
