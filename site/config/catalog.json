    { "id": "hiring_accepted", "label": "Offer accepted", "dept": "hiring", "unit": "count",
      "source": { "ref": "hiring_tracker", "tab": "Candidates", "agg": "count", "where": { "column": "status", "equals": "accepted" } },
      "denominator": { "kind": "metric", "metric": "hiring_plan", "label": "in plan" }, "direction": "up", "target": null, "warn_at": 0.7, "crit_at": 0.4,
      "caption": "{{raw}} of {{denominator}} {{denominator_label}}" },

    { "id": "hiring_joined", "label": "Joined", "dept": "hiring", "unit": "count",
