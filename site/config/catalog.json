        { "metric": "hiring_time_to_close","label": "TTC",    "sublabel": "MEDIAN DAYS","format": "raw" }
      ]
    }
  ],

  "_metric_note": "target is null everywhere on purpose. Each department head sets their own, once. Until then every one of these raises a no_target flag with their name on it.",

